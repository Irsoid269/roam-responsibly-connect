# Copy to .env and fill values as needed.
# VITE_PLAUSIBLE_DOMAIN=amani-resorts.com

# Stripe publishable key ONLY (pk_...) — safe to expose client-side.
# The secret key (sk_...) and STRIPE_WEBHOOK_SECRET go exclusively in the
# Supabase Edge Functions secrets (dashboard or `supabase secrets set`),
# never in this file or any client-side code.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mapbox public token (pk.*) — also safe to expose client-side, it's scoped
# to map rendering only. Get one free at https://account.mapbox.com/.
# VITE_MAPBOX_TOKEN=pk...

# Web Push VAPID public key — safe to expose client-side (it's the public
# half of an EC keypair used only to identify this app to push services).
# The matching VAPID_PRIVATE_KEY must go into Supabase Edge Function
# secrets ONLY, never here or in any client-side code.
# VITE_VAPID_PUBLIC_KEY=...
